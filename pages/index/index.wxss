.container {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 0;
  overflow: hidden;
}

.hero {
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #3D3929;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9B978D;
}

/* 左侧侧边栏 + 右侧列表 主体区 */
.menu-main {
  flex: 1;
  min-height: 0;
  display: flex;
  padding-bottom: 24rpx;
}

/* 左侧分类侧边栏 */
.side-bar {
  width: 180rpx;
  flex-shrink: 0;
  height: 100%;
  background: #F1EFE9;
  border-radius: 20rpx;
  overflow: hidden;
  margin-right: 20rpx;
}

.side-item {
  position: relative;
  padding: 28rpx 16rpx;
  font-size: 24rpx;
  color: #8B857A;
  text-align: center;
  line-height: 1.35;
  border-bottom: 1rpx solid #EBE8E0;
}

.side-item:last-child {
  border-bottom: none;
}

.side-item.active {
  background: #FFFFFF;
  color: #DA7756;
  font-weight: 500;
}

.side-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 44rpx;
  background: #DA7756;
  border-radius: 0 4rpx 4rpx 0;
}

/* 右侧内容区 */
.side-content {
  flex: 1;
  min-width: 0;
  height: 100%;
}

.content-scroll {
  height: 100%;
}

.sort-bar {
  display: flex;
  padding: 8rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
}

.sort-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #9B978D;
}

.sort-item.active {
  background: #3D3929;
  color: #FFFFFF;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #3D3929;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(61, 57, 41, 0.18);
  z-index: 10;
}
