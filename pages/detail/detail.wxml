<view wx:if="{{dish}}">
  <!-- 头图区 -->
  <view class="detail-cover">
    <image wx:if="{{dish.image}}" class="cover-img" src="{{dish.image}}" mode="aspectFill"></image>
    <view wx:else class="cover-letter-big">{{dish.firstChar}}</view>
    <view wx:if="{{dish.wished}}" class="cover-wish">已在想吃清单</view>
  </view>

  <view class="container">
    <!-- 基础信息 -->
    <view class="card info-card">
      <view class="name-row">
        <text class="dish-name">{{dish.name}}</text>
        <view class="avg-block">
          <text class="avg-num">{{avgText}}</text>
          <star-rating value="{{avg}}" readonly size="26"></star-rating>
        </view>
      </view>

      <view wx:if="{{dish.desc}}" class="detail-desc">“{{dish.desc}}”</view>

      <view class="tag-row">
        <text class="tag tag-{{item.type}}" wx:for="{{tags}}" wx:key="text">{{item.text}}</text>
      </view>

      <view class="ing-block">
        <view class="block-label">主要食材</view>
        <view class="ing-list">
          <text class="ing" wx:for="{{dish.ingredients}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 我的评价（支持上传图片） -->
    <view class="card rate-card">
      <view class="block-label">我的评价</view>
      <view class="my-score-row">
        <text class="my-score-text">这道菜值得几颗星？</text>
        <star-rating value="{{myScore}}" readonly="{{false}}" size="52" bind:change="onScore"></star-rating>
      </view>
      <textarea class="comment-input" placeholder="说两句吧，比如：火候、咸淡、最爱的搭配…" value="{{myComment}}" bind:input="onComment" maxlength="200"></textarea>

      <view class="upload-block">
        <view
          wx:for="{{ratingImages}}"
          wx:key="*this"
          class="upload-img"
        >
          <image class="upload-img-src" src="{{item}}" mode="aspectFill" data-index="{{index}}" bind:tap="previewImg" data-urls="{{ratingImages}}" data-url="{{item}}"></image>
          <view class="upload-del" data-index="{{index}}" catch:tap="removeRatingImage">×</view>
        </view>
        <view wx:if="{{ratingImages.length < 4}}" class="upload-add" bind:tap="chooseRatingImage">
          <text class="upload-plus">＋</text>
          <text class="upload-tip">上传图片</text>
        </view>
      </view>
      <view class="upload-hint">最多上传 4 张</view>

      <button class="btn-primary submit-btn" bind:tap="submitRating" loading="{{submitting}}">提交评价</button>
    </view>

    <!-- 评价列表 -->
    <view class="card review-card">
      <view class="block-label">
        评价列表
        <text class="review-count">{{dish.ratings.length}} 条</text>
      </view>
      <view wx:if="{{!dish.ratings.length}}" class="review-empty">还没有评价，快来当第一个吃螃蟹的人</view>
      <view wx:for="{{dish.ratings}}" wx:key="id" class="review-item">
        <view class="review-head">
          <star-rating value="{{item.score}}" readonly size="22"></star-rating>
          <text class="review-time">{{item.timeText}}</text>
        </view>
        <view wx:if="{{item.comment}}" class="review-comment">{{item.comment}}</view>
        <view wx:if="{{item.images && item.images.length}}" class="review-imgs">
          <image
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:key="*this"
            class="review-img"
            src="{{img}}"
            mode="aspectFill"
            data-urls="{{item.images}}"
            data-url="{{img}}"
            bind:tap="previewImg"
          ></image>
        </view>
      </view>
    </view>

    <!-- 操作栏：仅收藏入口（编辑与删除在管理后台） -->
    <view class="action-bar">
      <button class="btn-ghost action-btn" bind:tap="toggleWish">{{dish.wished ? '已在想吃清单' : '加入想吃清单'}}</button>
    </view>
  </view>
</view>
