/* 全局样式：Claude 风格设计系统
   暖米白底 / 柔和白卡 / 墨色文字 / 珊瑚橙点缀 / 克制排版 */
page {
  background: #FAF9F5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #3D3929;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border: 1rpx solid #EDEBE4;
  border-radius: 24rpx;
  box-shadow: 0 1px 3px rgba(61, 57, 41, 0.05);
}

/* 按钮 */
.btn-primary {
  background: #3D3929;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #FFFFFF;
  color: #3D3929;
  border: 1rpx solid #E3E0D8;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 400;
}

.btn-ghost::after {
  border: none;
}

/* 热度标签：克制 subtle 胶囊，仅"Top1"用品牌橙强调 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 400;
  background: #F0EDE6;
  color: #6B665C;
  margin: 0 16rpx 12rpx 0;
  line-height: 1.5;
}

.tag-top {
  background: #DA7756;
  color: #FFFFFF;
}

.tag-hot,
.tag-good,
.tag-order,
.tag-wish,
.tag-new {
  background: #F0EDE6;
  color: #6B665C;
}

.empty-tip {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9B978D;
  font-size: 24rpx;
}
